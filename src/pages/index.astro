---
import { Image } from "astro:assets";
import MainLayout from "../layouts/MainLayout.astro";

import heroImage from "../assets/images/heroImage.jpg";
import sakkechar from "../assets/images/sakkechar.jpeg";

const BOAT_ID = "6755394716189376";
const embedUrl = `https://www.noforeignland.com/home/map/embed/${BOAT_ID}/10/on/day`;
---

<MainLayout>
  <!-- HERO SECTION -->
  <section>
    <div class="grid hero-section">
      <div class="hero-content">
        <hgroup>
          <h1>Welcome to Samuels Sailing</h1>
          <p class="hero-text">
            We are Charlotte & Sakke. We swapped our home for a sailboat and are
            now sailing in the Mediterranean Sea. Follow our adventures and
            experiences as we explore the world from the sea.
          </p>
          <div class="hero-buttons">
            <a href="/blog" role="button" class="hero-cta">Read Our Blog</a>
            <a href="#location" role="button" class="hero-cta secondary"
              >Where Are We?</a
            >
          </div>
        </hgroup>
      </div>
      <div class="hero-image">
        <Image
          class="hero-image"
          src={heroImage}
          alt="Samuels Sailing"
          loading="eager"
          fetchpriority="high"
          widths={[400, 800, 1200]}
          sizes="(max-width: 600px) 400px, (max-width: 1000px) 800px, 1200px"
        />
      </div>
    </div>
  </section>

  <!-- WHO ARE WE SECTION -->
  <section>
    <div class="grid about-section">
      <div>
        <Image
          src={sakkechar}
          alt="Sakke and Charlotte on a sailboat"
          class="about-image"
          widths={[400, 800]}
          sizes="(max-width: 600px) 400px, 800px"
        />
      </div>
      <div>
        <p class="about-heading-small">A little bit about us</p>
        <h2 class="about-heading">We are Charlotte & Sakke</h2>
        <p>
          We were both working as PE teachers. During one of our holidays
          Charlotte saw a boat anchored near the shore and asked, "Why can't we
          do that?" We both looked at each other for a bit and thought "Why
          can't we?"
        </p>
        <p>
          We got back home and started planning for our future at sea. We did
          our Competent Crew course in Greece and then our Day Skipper in
          Gibraltar. After a few years of training and saving up for our
          adventure we found a boat, quit our jobs, and moved aboard Wonderer.
        </p>
        <a href="/boat">Learn more about our boat Wonderer →</a>
        <hr />
        <p>
          We moved onto our boat in July 2026. The boat was moored in Cartagena,
          Spain. We spent the whole month preparing our boat for living and
          sailing around the Mediterranean Sea (for now).
        </p>
        <a href="/blog">Read more on our blog →</a>
        <hr />
      </div>
    </div>
  </section>

  <!-- LOCATION SECTION -->
  <!-- LOCATION SECTION -->
  <section id="location">
    <div class="location-wrapper">
      <div class="tracking-card">
        <div class="tracking-icon">📍</div>
        <h3>Live Tracking on NoForeignLand</h3>
        <p>
          We log our live positions, passages, and anchorages aboard <em
            >Wonderer</em
          > directly on the NoForeignLand map.
        </p>
        <a
          href="https://www.noforeignland.com/boat/6755394716189376"
          target="_blank"
          rel="noopener noreferrer"
          role="button"
          class="hero-cta"
        >
          View Live Map on NoForeignLand ↗
        </a>
        <small class="tracking-note">
          Opens our official live tracking page in a new tab.
        </small>
      </div>
    </div>
  </section>
  <hr />
</MainLayout>

<style>
  .hero-content {
    @media (width >= 32rem) {
      align-content: center;
    }
  }
  .hero-text {
    margin-block: 1.5rem;
    max-width: 50ch;
  }
  .hero-buttons {
    display: flex;
    justify-content: baseline;
    flex-direction: row;
    gap: 20px;

    @media (width >= 62rem) {
      justify-content: flex-start;
    }
  }
  .hero-cta {
    color: #fff;
  }
  .hero-image {
    object-fit: cover;
    height: 100%;
    width: 100%;
    border-radius: var(--pico-border-radius, 8px);
  }

  .about-section {
    /* margin-block: 4rem; */
    align-items: center;
  }

  .about-heading-small {
    margin-block-end: 0;
    color: var(--pico-primary);
  }

  .about-heading {
    margin-block-start: 0px;
  }

  .about-image {
    width: 100%;
    max-height: 650px; /* Limits the height */

    /* Crucial: prevents stretching and crops the overflow */
    object-fit: cover;

    /* Directs the crop focus (e.g. keeps faces visible near the top) */
    object-position: center 50%;

    border-radius: var(--pico-border-radius, 8px);
  }

  #location {
    text-align: center;
    margin-block-end: 3rem;
  }

  .location-wrapper {
    max-width: 750px;
    margin: 0 auto;
  }

  .tracking-card {
    padding: 2.5rem 1.5rem;
    margin-block: 2rem;
    background: var(--pico-card-background-color, #1e232a);
    border: 1px solid var(--pico-muted-border-color, rgba(255, 255, 255, 0.1));
    border-radius: var(--pico-border-radius, 8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.15);
  }

  .tracking-icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .tracking-card h3 {
    margin-block: 0;
  }

  .tracking-card p {
    max-width: 45ch;
    margin: 0 auto;
  }

  .tracking-note {
    color: var(--pico-muted-color, #888);
    font-size: 0.85rem;
  }

  .disclaimer-text {
    max-width: 50ch;
    margin: 1.5rem auto 0;
    font-size: 0.95rem;
    color: var(--pico-muted-color, #aaa);
  }
</style>
