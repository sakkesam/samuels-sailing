---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/global/BaseHead.astro";
import Footer from "../components/global/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/global/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

import "@picocss/pico/css/pico.min.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body>
    <Header />

    <main class="container">
      <!-- Floating Back Button -->
      <a href="/blog/" class="floating-back-btn" aria-label="Back to all posts">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m12 19-7-7 7-7"></path>
          <path d="M19 12H5"></path>
        </svg>
        <span class="btn-text">Back to posts</span>
      </a>
      <article class="blog-article">
        <!-- Post Header -->
        <header class="article-header">
          <div class="post-meta">
            <time datetime={pubDate.toISOString()}>
              <FormattedDate date={pubDate} />
            </time>
            {
              updatedDate && (
                <span class="last-updated">
                  • Updated <FormattedDate date={updatedDate} />
                </span>
              )
            }
          </div>
          <h1>{title}</h1>
          <p class="article-description">{description}</p>
        </header>

        <!-- Featured Hero Image -->
        {
          heroImage && (
            <div class="hero-image-wrapper">
              <Image
                width={1200}
                height={630}
                src={heroImage}
                alt={title}
                format="webp"
                loading="eager"
              />
            </div>
          )
        }

        <!-- Main Markdown Content -->
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>

    <Footer />
  </body>
</html>

<style>
  /* Sticky Floating Back Button */
  .floating-back-btn {
    position: fixed;
    top: 6rem;
    left: 2rem;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--pico-color);
    background-color: var(--pico-card-background-color);
    border: 1px solid var(--pico-border-color);
    border-radius: 50px; /* Pill shape */
    box-shadow: var(--pico-card-box-shadow);
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .floating-back-btn svg {
    transition: transform 0.2s ease;
  }

  .floating-back-btn:hover {
    color: var(--pico-primary);
    border-color: var(--pico-primary);
    transform: translateY(-2px);
  }

  .floating-back-btn:hover svg {
    transform: translateX(-3px);
  }

  /* Responsive Mobile Tweak: On narrow screens, turn into an icon button */
  @media (max-width: 64rem) {
    .floating-back-btn {
      left: 1rem;
      padding: 0.6rem;
      border-radius: 50%;
    }

    .floating-back-btn .btn-text {
      display: none; /* Hide label text on mobile to save screen space */
    }
  }
  /* Limit maximum reading width for optimal typography */
  .blog-article {
    max-width: 780px;
    margin: 0 auto;
    padding: var(--pico-block-spacing-vertical, 2rem) 0;
    border: none;
    box-shadow: none;
    background: transparent;
  }

  /* Article Header */
  .article-header {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--pico-border-color);
  }

  .post-meta {
    font-size: 0.9rem;
    color: var(--pico-muted-color);
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .last-updated {
    font-style: italic;
    text-transform: none;
  }

  .article-header h1 {
    font-size: 2.25rem;
    line-height: 1.25;
    margin-bottom: 0.75rem;
    color: var(--pico-color);
  }

  .article-description {
    font-size: 1.15rem;
    color: var(--pico-muted-color);
    margin: 0 auto;
    max-width: 650px;
    line-height: 1.5;
  }

  /* Hero Image */
  .hero-image-wrapper {
    margin-bottom: 2.5rem;
    border-radius: var(--pico-border-radius, 8px);
    overflow: hidden;
    box-shadow: var(--pico-card-box-shadow);
  }

  .hero-image-wrapper img {
    width: 100%;
    height: auto;
    max-height: 480px;
    object-fit: cover;
    display: block;
  }

  /* Markdown Body Formatting (.prose) */
  .prose {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--pico-color);
  }

  /* Heading Anchors & Margins */
  .prose :global(h2) {
    font-size: 1.6rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--pico-border-color);
  }

  .prose :global(h3) {
    font-size: 1.3rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  /* Paragraphs & Lists */
  .prose :global(p) {
    margin-bottom: 1.5rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.4rem;
  }

  /* Blockquotes */
  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--pico-primary);
    background-color: var(--pico-card-background-color);
    border-radius: 0 var(--pico-border-radius, 4px)
      var(--pico-border-radius, 4px) 0;
    font-style: italic;
  }

  .prose :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* Inline Code & Code Blocks */
  .prose :global(code:not(pre code)) {
    padding: 0.2rem 0.4rem;
    font-size: 0.875em;
    border-radius: 4px;
    background-color: var(
      --pico-code-background-color,
      rgba(255, 255, 255, 0.1)
    );
  }

  .prose :global(pre) {
    margin: 1.75rem 0;
    padding: 1.25rem;
    border-radius: var(--pico-border-radius, 8px);
    overflow-x: auto;
  }

  /* Content Images */
  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--pico-border-radius, 8px);
    margin: 2rem 0;
    box-shadow: var(--pico-card-box-shadow);
  }

  /* Tables */
  .prose :global(table) {
    width: 100%;
    margin: 2rem 0;
  }
</style>
